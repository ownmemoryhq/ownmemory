{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"types": ["@cloudflare/workers-types"],
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "public/keys.js", "public/memory-file.js"]
}
